{
  // Type-checking config used for tests: builds on the app config but drops its
  // "exclude" (so __tests__ files are checked too) and adds Node/jsdom types.
  "extends": "./tsconfig.app.json",
  "exclude": [],
  "compilerOptions": {
    "composite": true,
    "lib": [], // inherit lib from the extended config instead of overriding it
    "types": ["node", "jsdom"] // Node globals (vitest runs in Node) plus jsdom's DOM types
  }
}
